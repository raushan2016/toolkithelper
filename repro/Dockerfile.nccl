# Stage 1: Build nccl-tests
FROM pytorch/pytorch:2.9.1-cuda13.0-cudnn9-devel AS builder

RUN apt-get update && apt-get install -y --no-install-recommends git make g++ libopenmpi-dev

RUN git clone https://github.com/NVIDIA/nccl-tests.git /nccl-tests
WORKDIR /nccl-tests
# Build with MPI support
RUN make MPI=1 NCCL_HOME=/usr/local/cuda MPI_HOME=/usr/lib/x86_64-linux-gnu/openmpi

# Stage 2: Runtime image (using devel to ensure all libs are present)
FROM pytorch/pytorch:2.9.1-cuda13.0-cudnn9-devel

# Install OpenMPI runtime, SSH, and tools for repo setup
RUN apt-get update && apt-get install -y --no-install-recommends openmpi-bin openssh-server openssh-client curl gnupg && \
    mkdir -p /var/run/sshd

# Add Google Cloud apt repo and install nccl-gib
RUN curl http://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /etc/apt/trusted.gpg.d/cloud.google.gpg && \
    echo 'deb https://packages.cloud.google.com/apt gpudirect-gib-apt main' | tee /etc/apt/sources.list.d/nccl-gib.list && \
    apt-get update && apt-get install -y nccl-gib

# Copy the compiled binary from the builder stage
COPY --from=builder /nccl-tests/build/alltoall_perf /usr/local/bin/alltoall_perf

# Set environment variables for gIB
ENV LD_LIBRARY_PATH=/usr/local/gib/lib64:$LD_LIBRARY_PATH


# Configure SSH for non-interactive use by MPI
RUN sed -i 's/[ #]\(.*StrictHostKeyChecking \).*/ \1no/g' /etc/ssh/ssh_config && \
    echo "    UserKnownHostsFile /dev/null" >> /etc/ssh/ssh_config && \
    sed -i 's/#\(StrictModes \).*/\1no/g' /etc/ssh/sshd_config

# Expose SSH port
EXPOSE 22
